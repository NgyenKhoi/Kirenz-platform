# Merge these server-only values into the existing root .env.
# Keep the other database, Redis, Kafka and app settings already in your .env.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET
LIVEKIT_TOKEN_TTL=PT2M
LIVEKIT_RING_TIMEOUT=PT60S
LIVEKIT_DISCONNECT_TIMEOUT=PT45S
